# Read automatically by `docker compose` and substituted into compose.yaml.
# This is a lab, so these values are committed. In a real project, keep this file out of git.

# The proxy listens on both ports: http://<host>:8080/course/ and http://<host>/course/.
# Port 80 already in use on your machine (or not allowed)? Remove PROXY_PORT_2.
PROXY_PORT=8080
PROXY_PORT_2=80

# Shared secret: the api checks it, the client sends it in the X-API-KEY header.
API_KEY=super-secret-lab-key

DB_DATABASE=books
DB_USERNAME=books_user
DB_PASSWORD=books_pwd
DB_ROOT_PASSWORD=root
